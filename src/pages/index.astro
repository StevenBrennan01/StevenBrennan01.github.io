---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main">
			<section class="sb-hero" aria-labelledby="sb-hero-title">
			<video
				class="sb-heroVideo"
				poster="/poster.png"
				autoplay
				muted
				loop
				playsinline
				preload="none"
				aria-hidden="true"
			>
				<source src="/TankGameplayLoop.mp4" type="video/mp4" />
			</video>

			<div class="sb-heroOverlay" aria-hidden="true"></div>

			<div class="sb-heroContent">
				<img class="sb-avatar" src="/me.png" alt="Portrait of Steven Brennan" width="240" height="240" />
				<div>
				<h1 id="sb-hero-title" class="sb-name">Steven Brennan</h1>
				<h2 class="sb-role">BSc (Hons) Games Programming and Design Gameplay Programmer</h2>
				</div>
			</div>
			</section>

			<p class="sb-intro"> 
			Hi, I'm <strong><a href="https://www.linkedin.com/in/steven-brennan-37b473234/" target="_blank" rel="noopener noreferrer">Steve</a></strong>, a recently graduated Games Programmer from the University of Staffordshire for Games Programming and Design. 
			My expertise include working primarily within the <span class="sb-highlight">Unity</span> engine using <span class="sb-highlight">C#</span>, alongside 
			<span class="sb-highlight">Unreal</span> (Blueprints), <span class="sb-highlight">C++</span> using the <span class="sb-highlight">SFML</span> library 
			and I'm currently exploring and learning within the <span class="sb-highlight">S&amp;box</span> engine (Facepunch) through personal projects.
			</p>

			<section class="sb-projectSection" aria-labelledby="games-title">
				<h2 id="games-title" class="sb-sectionTitle">Game Projects</h2>

				<div class="sb-projectGrid">
					<a class="sb-projectCard" href="/projects/hardwhere" aria-label="View HardWhere">
						<video
							class="sb-projectVideo"
							poster="/HardWhere_Poster.png"
							autoplay
							muted
							loop
							playsinline
							preload="none"
							aria-hidden="true"
						>
							<source src="/HardGameplayLoop.mp4" type="video/mp4" />
						</video>
						<div class="sb-projectOverlay" aria-hidden="true"></div>
						<div class="sb-projectContent">
							<img class="sb-projectTitleImage" src="/HardWhereTitleCard.png" alt="HardWhere title card" />
						</div>
					</a>

					<a class="sb-projectCard" href="/projects/cursor" aria-label="View Cursor.Zip">
						<video
							class="sb-projectVideo"
							poster="/Cursor_Poster.png"
							autoplay
							muted
							loop
							playsinline
							preload="none"
							aria-hidden="true"
						>
							<source src="/CursorGameplayLoop.mp4" type="video/mp4" />
						</video>
						<div class="sb-projectOverlay" aria-hidden="true"></div>
						<div class="sb-projectContent">
							<img class="sb-projectTitleImage" src="/CursorTitleCard.png" alt="Cursor title card" />
						</div>
					</a>

					<a class="sb-projectCard" href="/projects/galatea" aria-label="View Galatea">
						<video
							class="sb-projectVideo"
							poster="/Galatea_Poster.png"
							autoplay
							muted
							loop
							playsinline
							preload="none"
							aria-hidden="true"
						>
							<source src="/GalateaGameplayLoop.mp4" type="video/mp4" />
						</video>
						<div class="sb-projectOverlay" aria-hidden="true"></div>
						<div class="sb-projectContent">
							<img class="sb-projectTitleImage" src="/GalateaTitleCard.png" alt="Galatea title card" />
						</div>
					</a>

					<a class="sb-projectCard" href="/projects/tankroyale" aria-label="View Tank Royale">
						<video
							class="sb-projectVideo"
							poster="/poster.png"
							autoplay
							muted
							loop
							playsinline
							preload="none"
							aria-hidden="true"
						>
							<source src="/TankGameplayLoop.mp4" type="video/mp4" />
						</video>
						<div class="sb-projectOverlay" aria-hidden="true"></div>
						<div class="sb-projectContent">
							<img class="sb-projectTitleImage" src="/TankTitleCard.png" alt="TankRoyale title card" />
						</div>
					</a>

					<a class="sb-projectCard" href="/projects/frogger" aria-label="View ModernisedFrogger">
						<video
							class="sb-projectVideo"
							poster="/Frogger_Poster.png"
							autoplay
							muted
							loop
							playsinline
							preload="none"
							aria-hidden="true"
						>
							<source src="/Frogger_GameplayLoop.mp4" type="video/mp4" />
						</video>
						<div class="sb-projectOverlay" aria-hidden="true"></div>
						<div class="sb-projectContent">
							<img class="sb-projectTitleImage" src="/FroggerTitleCard.png" alt="Frogger title card" />
						</div>
					</a>
				</div>
			</section>

			<section class="sb-projectSection" aria-labelledby="tools-title">
				<h2 id="tools-title" class="sb-sectionTitle">Development Tools</h2>

				<div class="sb-projectGrid">
					<a class="sb-projectCard" href="/projects/kanbantool" aria-label="Kanban Tool">
						<video
							class="sb-projectVideo"
							poster="/Kanban_Poster.png"
							autoplay
							muted
							loop
							playsinline
							preload="none"
							aria-hidden="true"
						>
							<source src="/KanbanGameplayLoop.mp4" type="video/mp4" />
						</video>
						<div class="sb-projectOverlay" aria-hidden="true"></div>
						<div class="sb-projectContent">
							<img class="sb-projectTitleImage" src="/KanbanTitleCard.png" alt="KanbanTool title card" />
						</div>
					</a>
				</div>
			</section>

			</main>

			<style>
			/* Hero container */
			.sb-hero {
			position: relative;
			overflow: hidden;

			margin-top: 1.25rem;
			padding: 2rem 1.5rem;
			border-radius: 16px;

			/* Optional: gives it a subtle card feel */
			border: 2px solid var(--border-color);
			background: var(--content-bg, transparent);

			width: min(1000px, calc(100vw - 2rem));
			left: 50%;
			transform: translateX(-50%);
			min-height: 225px;
			}

			/* Background video */
			.sb-heroVideo {
			position: absolute;
			inset: 0;

			width: 100%;
			height: 100%;
			object-fit: cover;

			/* The “blurred background” effect */
			filter: blur(4px) brightness(0.65) saturate(1.15);
			transform: scale(1.08); /* avoids blurred edges showing */
			}

			/* Dark overlay for readability (tune opacity to taste) */
			.sb-heroOverlay {
			position: absolute;
			inset: 0;
			background: linear-gradient(
				90deg,
				rgba(0, 0, 0, 0.65),
				rgba(0, 0, 0, 0.25)
			);
			}

			/* Foreground content */
			.sb-heroContent {
			position: relative;
			z-index: 1;

			display: flex;
			align-items: center;
			gap: 1rem;
			}

			/* Avatar */
			.sb-avatar {
			display: block;
			float: none;

			width: 240px;
			height: 240px;
			object-fit: cover;
			flex: 0 0 auto;
			}

			/* Text */
			.sb-name {
			margin: 0;
			}

			.sb-role {
			margin: 0.25rem 0 0 0;
			opacity: 0.9;
			font-weight: 500;
			}

			/* Mobile layout: stack nicely */
			@media (max-width: 720px) {
			.sb-hero {
				padding: 1.5rem 1rem;
				min-height: 360px;
			}

			.sb-heroContent {
				flex-direction: column;
				align-items: flex-start;
			}

			.sb-avatar {
				width: 160px;
				height: 160px;
			}
			}

			.sb-showreel {
			margin-top: 2rem;
			}

			.sb-videoWrap {
			position: relative;
			width: 100%;
			aspect-ratio: 16 / 9;
			border-radius: 16px;
			overflow: hidden;
			border: 1px solid var(--border-color);
			background: #000;
			}

			.sb-intro {
			text-align: center;
			max-width: 875px;
			margin: 0 auto;
			}

			.sb-video {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			}

			.sb-highlight {
			color: var(--accent);
			font-weight: 600;
			}

			.sb-projectSection {
			margin-top: 3rem;
			width: min(1360px, calc(100vw - 2rem));
			position: relative;
			left: 50%;
			transform: translateX(-50%);
		}

		.sb-sectionTitle {
			margin-bottom: 1rem;
			text-align: center;
		}

		.sb-projectGrid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.25rem;
		}

		@media (max-width: 720px) {
			.sb-projectSection {
				width: 100%;
				left: auto;
				transform: none;
			}

			.sb-projectGrid {
				grid-template-columns: 1fr;
			}

			.sb-projectCard {
				min-height: 220px;
			}

			.sb-projectContent {
				min-height: 220px;
				padding: 1rem;
			}

			.sb-projectTitleImage {
				max-width: 85%;
				max-height: 110px;
			}
		}

			.sb-projectCard {
				position: relative;
				display: block;
				overflow: hidden;
				border-radius: 18px;
				border: 2px solid var(--border-color);
				background: var(--content-bg, transparent);
				min-height: 260px;
				width: 100%;
				text-decoration: none;
				transform: translateY(0) scale(1);
				transition:
					transform 0.25s ease,
					box-shadow 0.25s ease,
					border-color 0.25s ease;
			}

			.sb-projectCard:hover {
				transform: translateY(-4px) scale(1.02);
				box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22);
				border-color: var(--accent);
			}

			.sb-projectCard:focus-visible {
				outline: 3px solid var(--accent);
				outline-offset: 4px;
			}

			.sb-projectVideo {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				filter: blur(5px) brightness(0.55) saturate(1.1);
				transform: scale(1.06);
			}

			.sb-projectOverlay {
				position: absolute;
				inset: 0;
				background: linear-gradient(
					90deg,
					rgba(0, 0, 0, 0.62),
					rgba(0, 0, 0, 0.25)
				);
			}

			.sb-projectContent {
				position: relative;
				z-index: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: 260px;
				padding: 1.5rem;
			}

			.sb-projectTitleImage {
				display: block;
				max-width: min(75%, 520px);
				max-height: 140px;
				width: auto;
				height: auto;
				object-fit: contain;
			}

			@media (max-width: 720px) {
				.sb-projectCard {
					min-height: 220px;
				}

				.sb-projectContent {
					min-height: 220px;
					padding: 1rem;
				}

				.sb-projectTitleImage {
					max-width: 85%;
					max-height: 110px;
				}
			}

			</style>

		<Footer />
	</body>
</html>