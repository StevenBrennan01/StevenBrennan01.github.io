---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const PAGE_TITLE = 'Galatea | Steven Brennan';
const PAGE_DESCRIPTION = 'Galatea project page showcasing gameplay programming work, technical highlights, and development experience.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={PAGE_TITLE} description={PAGE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main id="main">
			<section class="project-hero" aria-labelledby="project-title">
				<video
					class="project-hero-video"
					poster="/Galatea_Poster.png"
					autoplay
					muted
					loop
					playsinline
					preload="none"
					aria-hidden="true"
				>
					<source src="/GalateaGameplayLoop.mp4" type="video/mp4" />
				</video>

				<div class="project-hero-overlay" aria-hidden="true"></div>

				<div class="project-hero-content">
					<img
						class="project-title-image"
						src="/GalateaTitleCard.png"
						alt="Galatea title card"
					/>
				</div>
			</section>

			<section class="project-section">
				<h2 class="sr-only" id="project-title">Galatea</h2>
				<p class="project-summary">
					<strong>An Entry-Favourite of the 2024 GMTK Game-Jam</strong>
				</p>
				<p class="project-summary">
					Our entry for the 2024 GMTK Game-Jam for the "Built to Scale" theme.
				</p>
			</section>

			<section class="project-section" aria-labelledby="video-title">
				<div class="project-video-wrap">
					<iframe
						class="project-video"
						src="https://www.youtube-nocookie.com/embed/3v6ngkZX2P4?autoplay=1&mute=1&rel=0&playsinline=1"
						title="Galatea gameplay video"
						allow="autoplay; encrypted-media; picture-in-picture"
						allowfullscreen
					></iframe>
				</div>
			</section>

			<section class="project-section" aria-labelledby="skills-title">
				<h2 id="skills-title">Skills Used:</h2>
				<div class="project-tags">
					<span class="project-tag">Unity</span>
					<span class="project-tag">C#</span>
					<span class="project-tag">Gameplay Programming</span>
				</div>
			</section>

			<section class="project-section" aria-labelledby="overview-title">
				<h2 id="overview-title">Overview</h2>
				<p>Galatea is a puzzle game about navigating through endlessly repeating spaces and reducing your scale
				enough to find Galatea hidden within.</p>
			</section>

			<section class="project-section" aria-labelledby="worked-on-title">
				<h2 id="worked-on-title">What I worked on:</h2>
				<ul class="project-list">
					<li>UI Programming</li>
					<li>Prototyping gameplay ideas</li>
					<li>Picking my Lead Programmers Brain</li>
				</ul>
			</section>

			<section class="project-section" aria-labelledby="challenges-title">
				<h2 id="challenges-title">What I learnt:</h2>
				<p>A lot. It was a huge learning experience for me and I learnt a lot of things from this project such as how to use
				Events, about Lambda Expressions, Ternary Operators and many other clean code and development practices from the guidance of my Lead-Programmer.
				</p>
				
			</section>

			<section class="project-section" aria-labelledby="links-title">
				<h2 id="links-title">Game Build:</h2>
				<ul class="project-links">
					<li>
						<a href="https://pehre.itch.io/galatea" target="_blank" rel="noopener noreferrer">
							Itch.io build
						</a>
					</li>
				</ul>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.project-hero {
		position: relative;
		overflow: hidden;
		margin-top: 1.25rem;
		padding: 2rem 1.5rem;
		border-radius: 18px;
		border: 2px solid var(--border-color);
		background: var(--content-bg, transparent);
		width: min(1100px, calc(100vw - 2rem));
		left: 50%;
		transform: translateX(-50%);
		min-height: 300px;
	}

	.project-hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: blur(5px) brightness(0.55) saturate(1.1);
		transform: scale(1.08);
	}

	.project-hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0.25));
	}

	.project-hero-content {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 300px;
		padding: 1.5rem;
	}

	.project-title-image {
		display: block;
		max-width: min(82%, 680px);
		max-height: 200px;
		width: auto;
		height: auto;
		object-fit: contain;
	}

	.project-section {
		margin-top: 2rem;
	}

	.project-summary {
		text-align: center;
		max-width: 850px;
		margin: 0 auto;
		font-size: 1.1rem;
	}

	.project-video-wrap {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid var(--border-color);
		background: #000;
	}

	.project-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.project-tag {
		display: inline-block;
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		background: rgba(35, 55, 255, 0.12);
		color: var(--accent);
		font-weight: 700;
		font-size: 0.95rem;
		border: 1px solid rgba(35, 55, 255, 0.18);
	}

	.project-list,
	.project-links {
		padding-left: 1.25rem;
	}

	pre {
		padding: 1rem 1.25rem;
		border-radius: 12px;
		overflow-x: auto;
		font-size: 0.85rem;
		line-height: 1.5;
		border: 2px solid var(--border-color);
		background: transparent;
	}

	pre code {
		font-size: inherit;
	}

	@media (max-width: 720px) {
		.project-hero {
			padding: 1.25rem 1rem;
			min-height: 220px;
		}

		.project-hero-content {
			min-height: 220px;
			padding: 1rem;
		}

		.project-title-image {
			max-width: 90%;
			max-height: 120px;
		}
	}
</style>